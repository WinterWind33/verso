#pragma once

#include <verso/verso.hpp>

namespace example {

consteval std::optional<verso::constant_version::prerelease_string_t> get_pre_release() noexcept {
    // clang-format off
    constexpr verso::constant_version::prerelease_string_t pre_release_str{"@VERSO_EXAMPLE_GEN_VERSION_PRE_RELEASE@"};
    if constexpr (!pre_release_str.empty()) {
        return pre_release_str;
        // clang-format on
    } else {
        return std::nullopt;
    }
}

consteval std::optional<verso::constant_version::build_metadata_string_t>
get_build_metadata() noexcept {
    // clang-format off
    constexpr verso::constant_version::build_metadata_string_t build_metadata_str{"@VERSO_EXAMPLE_GEN_VERSION_BUILD_METADATA@"};
    if constexpr (!build_metadata_str.empty()) {
        return build_metadata_str;
        // clang-format on
    } else {
        return std::nullopt;
    }
}

constexpr verso::constant_version GENERATED_VERSION {
    // clang-format off
        @VERSO_EXAMPLE_GEN_VERSION_MAJOR@,
        @VERSO_EXAMPLE_GEN_VERSION_MINOR@,
        @VERSO_EXAMPLE_GEN_VERSION_PATCH@,
        get_pre_release(),
        get_build_metadata()
    // clang-format on
};
} // namespace example
