{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "[Linux] (Debug) Launch verso tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tests/verso-tests",
            "args": [
                "-S"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "engineLogging": true
            },
            "preLaunchTask": "CMake: build"
        },
        {
            "name": "[Windows] (Debug) Launch verso tests",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\build\\tests\\Debug\\verso-tests.exe",
            "args": [
                "-S"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "externalTerminal",
            "preLaunchTask": "CMake: build"
        }
    ]
}
